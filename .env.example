# Local service ports
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# Backend runtime
DATABASE_URL=postgresql+psycopg://elite_tickets:elite_tickets@postgres:5432/elite_tickets
# Generate independent high-entropy values for each secret; never reuse either value.
JWT_SECRET=replace-with-a-unique-random-jwt-secret
QR_SECRET=replace-with-a-different-random-qr-secret

# Organizer-only external catalog integration.
TICKETMASTER_API_KEY=replace-with-your-ticketmaster-api-key

# Comma-separated browser origins allowed to call the API. Do not use * with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Browser-visible API endpoint. This value must never contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-side endpoint used by the Next.js container. This value must never contain secrets.
API_INTERNAL_BASE_URL=http://api:8000/api/v1
